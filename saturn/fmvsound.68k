| The sound CPU's program for the FMVs (docs/ps1-fmv.md): it decodes the
| videos' sound, the retail Saturn's 16-bit PCM packed losslessly by
| tools/lossless.py, into the two PCM rings the SCSP's slots loop over, one
| per channel. The SH-2 writes the packed chunks into a ring of its own in
| sound RAM (CRING), as they come off the disc; it moves WR on past what it
| wrote, this program moves RD past what it decoded.
|
| CMD from the SH-2 picks the work:
|   0 nothing
|   1 the speed test: CHUNKS chunks at CLIP decoded over and over into the
|     rings' starts, from cleared predictors each pass; COUNT counts the
|     samples (both channels), PASSES the passes
|   2 playing: chunks from CRING decoded into the rings, staying at most
|     AHEAD samples past PLAY (where the slots play, which the SH-2 writes);
|     DECODED counts the samples decoded (a channel's), LOW keeps the fewest
|     found decoded ahead of PLAY while packed chunks wait (below 0: a slot
|     played what wasn't there)
|
| The format (tools/lossless.py): a chunk is 1024 samples of each channel, 8
| blocks of 128 each, left then right: its bytes (a word), its byte stream's
| bytes n (a word), the byte stream, a pad byte if n is odd, then the field
| stream. A block's header byte (order << 3 | mode) picks how its samples'
| u (the residual, zigzagged) are kept: mode 0 a byte (192 or more: an
| escape), 1 a 2-bit field and a byte (field 3: an escape), 2 a 4-bit field
| and a byte (12 or more: an escape), 3 u whole; an escape is u whole, 2
| bytes. u adds to the block's fixed prediction of order 0-3, in 16 bits.
| A field comes from a table, FIELDS2 or FIELDS4, indexed by its byte of the
| field stream and its place in it: field << 8, or negative for an escape.
|
| Registers while decoding: a3 the byte stream, a4 the field stream, a1 the
| block's field table, a5 where samples go, d4 d5 d6 the last three
| samples, d3 a field byte times the table's stride, d2 the block's groups
| left, d7 the channel's blocks left.

    .equ    SHARED,     0xF000      | below the rings; the program from 0x400 up to the stack
    .equ    CMD,        SHARED+0x00 | word, the SH-2's
    .equ    CHUNKS,     SHARED+0x02 | word, the SH-2's: the speed test's chunks
    .equ    PASSES,     SHARED+0x04 | word
    .equ    STATE,      SHARED+0x06 | word: the CMD being done (0 when idle)
    .equ    COUNT,      SHARED+0x08 | long
    .equ    RD,         SHARED+0x0C | long: CRING bytes decoded, unwrapped
    .equ    WR,         SHARED+0x10 | long, the SH-2's: CRING bytes written
    .equ    PLAY,       SHARED+0x14 | long, the SH-2's: samples played
    .equ    DECODED,    SHARED+0x18 | long: samples decoded
    .equ    LOW,        SHARED+0x1C | long
    .equ    HIST,       SHARED+0x40 | 3 words a channel: x1 x2 x3

    .equ    RING_L,     0x10000     | the slots' rings: 32768 samples each
    .equ    RING_R,     0x20000
    .equ    RING_MASK,  0xFFFF      | of a ring's bytes
    .equ    CRING,      0x40000     | the packed chunks: 256 KB
    .equ    CRING_MASK, 0x3FFFF
    .equ    CLIP,       0x40000     | the speed test's chunks
    .equ    FIELDS2,    0x8000      | 256 x 4 words: the 2-bit fields of a byte
    .equ    FIELDS4,    0x8800      | 256 x 2 words: the 4-bit fields of a byte
    .equ    AHEAD,      16384

    .equ    STACK,      SHARED

    .text
    .long   STACK
    .long   start
    .org    0x400

start:
    | the field tables: each byte's fields, top first, as field << 8; an
    | escape (2 bits: 3; 4 bits: 12 or more) as 0x8000
    lea     FIELDS2,%a0
    moveq   #0,%d0                  | the byte
1:  moveq   #6,%d1                  | the field's shift
2:  move.w  %d0,%d2
    lsr.w   %d1,%d2
    and.w   #3,%d2
    cmp.w   #3,%d2
    bne.s   3f
    move.w  #0x8000,(%a0)+
    bra.s   4f
3:  lsl.w   #8,%d2
    move.w  %d2,(%a0)+
4:  subq.w  #2,%d1
    bpl.s   2b
    addq.w  #1,%d0
    cmp.w   #256,%d0
    bne.s   1b
    lea     FIELDS4,%a0
    moveq   #0,%d0
5:  moveq   #4,%d1
6:  move.w  %d0,%d2
    lsr.w   %d1,%d2
    and.w   #15,%d2
    cmp.w   #12,%d2
    bcs.s   7f
    move.w  #0x8000,(%a0)+
    bra.s   8f
7:  lsl.w   #8,%d2
    move.w  %d2,(%a0)+
8:  subq.w  #4,%d1
    bpl.s   6b
    addq.w  #1,%d0
    cmp.w   #256,%d0
    bne.s   5b
idle:
    clr.w   STATE
1:  move.w  CMD,%d0
    cmp.w   #1,%d0
    beq.s   speed
    cmp.w   #2,%d0
    beq     play
    bra.s   1b

| --- the speed test --------------------------------------------------------

speed:
    move.w  #1,STATE
    clr.w   PASSES
    clr.l   COUNT
1:  bsr     clear_history
    lea     CLIP,%a0
    lea     RING_L,%a1
    lea     RING_R,%a2
    move.w  CHUNKS,-(%sp)
2:  bsr     decode_chunk
    add.l   #2048,COUNT
    cmp.w   #1,CMD
    bne.s   3f
    subq.w  #1,(%sp)
    bne.s   2b
    addq.l  #2,%sp
    addq.w  #1,PASSES
    bra.s   1b
3:  addq.l  #2,%sp
    bra.s   idle

clear_history:
    lea     HIST,%a0
    clr.l   (%a0)+
    clr.l   (%a0)+
    clr.l   (%a0)+
    rts

| --- playing ---------------------------------------------------------------

play:
    move.w  #2,STATE
    clr.l   RD
    clr.l   DECODED
    clr.l   COUNT
    move.l  #0x7FFFFFFF,LOW
    bsr     clear_history
1:  cmp.w   #2,CMD
    bne     idle
    lea     PLAY,%a0
    bsr     read_long
    move.l  %d0,%d4
    lea     WR,%a0
    bsr     read_long
    move.l  RD,%d2
    sub.l   %d2,%d0                 | bytes written and not yet decoded
    move.l  DECODED,%d1
    sub.l   %d4,%d1                 | decoded ahead of the slots
    cmp.l   #4,%d0
    blt     1b                      | nothing to decode: LOW is the decoder's, not the feed's
    tst.l   %d4
    beq.s   2f                      | the slots haven't started
    cmp.l   LOW,%d1
    bge.s   2f
    move.l  %d1,LOW
2:  cmp.l   #AHEAD,%d1
    bge     1b
    move.l  %d2,%d3
    and.l   #CRING_MASK,%d3
    lea     CRING,%a0
    add.l   %d3,%a0
    moveq   #0,%d1
    move.w  (%a0),%d1               | the chunk's bytes; 0: go on from the ring's start
    bne.s   3f
    neg.l   %d3
    add.l   #CRING_MASK+1,%d3
    add.l   %d3,RD
    bra     1b
3:  cmp.l   %d1,%d0
    blt     1b                      | not all there yet
    move.l  %d1,-(%sp)
    move.l  DECODED,%d0
    add.l   %d0,%d0
    and.l   #RING_MASK,%d0
    lea     RING_L,%a1
    add.l   %d0,%a1
    lea     RING_R,%a2
    add.l   %d0,%a2
    bsr     decode_chunk
    move.l  (%sp)+,%d1
    add.l   %d1,RD
    add.l   #1024,DECODED
    add.l   #2048,COUNT
    bra     1b

| d0 = the long at a0, read until two reads agree (the SH-2 writes it a word
| at a time)
read_long:
    move.l  (%a0),%d0
1:  move.l  (%a0),%d1
    cmp.l   %d0,%d1
    beq.s   2f
    move.l  %d1,%d0
    bra.s   1b
2:  rts

| --- decoding ----------------------------------------------------------------

| The chunk at a0 into a1 (left) and a2 (right); returns a0, a1, a2 past it.
decode_chunk:
    move.w  (%a0)+,%d0              | the chunk's bytes
    pea     -2(%a0,%d0.w)           | its end
    move.l  %a2,-(%sp)              | where the right goes
    move.w  (%a0)+,%d1              | the byte stream's bytes
    move.l  %a0,%a3
    lea     0(%a0,%d1.w),%a4
    btst    #0,%d1
    beq.s   1f
    addq.l  #1,%a4
1:  movem.w HIST,%d4-%d6
    move.l  %a1,%a5
    bsr.s   channel
    movem.w %d4-%d6,HIST
    move.l  %a5,-(%sp)              | the left's end
    movem.w HIST+6,%d4-%d6
    move.l  4(%sp),%a5
    bsr.s   channel
    movem.w %d4-%d6,HIST+6
    move.l  %a5,%a2
    move.l  (%sp)+,%a1
    addq.l  #4,%sp
    move.l  (%sp)+,%a0
    rts

| a channel's 8 blocks, each decoded by the code for its order and mode
channel:
    moveq   #7,%d7
1:  moveq   #0,%d0
    move.b  (%a3)+,%d0              | order << 3 | mode
    add.w   %d0,%d0
    lea     blocks(%pc),%a6
    move.w  0(%a6,%d0.w),%d0
    jsr     0(%a6,%d0.w)
    dbra    %d7,1b
    rts

| u in d0 to the sample: from zigzag, plus the prediction; stored, and the
| last three moved on
    .macro  TAIL order
    lsr.w   #1,%d0
    bcc.s   9f
    not.w   %d0
9:
    .if     \order == 1
    add.w   %d4,%d0
    .endif
    .if     \order == 2
    add.w   %d4,%d0
    add.w   %d4,%d0
    sub.w   %d5,%d0
    .endif
    .if     \order == 3
    move.w  %d4,%d1
    sub.w   %d5,%d1
    add.w   %d1,%d0
    add.w   %d1,%d1
    add.w   %d1,%d0
    add.w   %d6,%d0
    .endif
    move.w  %d5,%d6
    move.w  %d4,%d5
    move.w  %d0,%d4
    move.w  %d0,(%a5)+
    .endm

| u whole from the byte stream
    .macro  WHOLE
    move.b  (%a3)+,%d0
    lsl.w   #8,%d0
    move.b  (%a3)+,%d0
    .endm

| a sample with a field: its table entry at disp(a1, d3), then its byte
    .macro  FIELD disp, order
    move.w  \disp(%a1,%d3.w),%d0
    bpl.s   1f
    move.b  (%a3)+,%d0              | an escape: u whole
    lsl.w   #8,%d0
1:  move.b  (%a3)+,%d0
    TAIL    \order
    .endm

| mode 0: a byte, 192 or more an escape
    .macro  MODE0 order
    move.w  #BLOCK_SAMPLES-1,%d2
2:  moveq   #0,%d0
    move.b  (%a3)+,%d0
    cmp.b   #192,%d0
    bcs.s   3f
    WHOLE
3:  TAIL    \order
    dbra    %d2,2b
    rts
    .endm

| mode 1: 4 samples a field byte
    .macro  MODE1 order
    lea     FIELDS2,%a1
    move.w  #BLOCK_SAMPLES/4-1,%d2
2:  moveq   #0,%d3
    move.b  (%a4)+,%d3
    lsl.w   #3,%d3
    FIELD   0, \order
    FIELD   2, \order
    FIELD   4, \order
    FIELD   6, \order
    dbra    %d2,2b
    rts
    .endm

| mode 2: 2 samples a field byte
    .macro  MODE2 order
    lea     FIELDS4,%a1
    move.w  #BLOCK_SAMPLES/2-1,%d2
2:  moveq   #0,%d3
    move.b  (%a4)+,%d3
    add.w   %d3,%d3
    add.w   %d3,%d3
    FIELD   0, \order
    FIELD   2, \order
    dbra    %d2,2b
    rts
    .endm

| mode 3: u whole
    .macro  MODE3 order
    move.w  #BLOCK_SAMPLES-1,%d2
2:  WHOLE
    TAIL    \order
    dbra    %d2,2b
    rts
    .endm

    .equ    BLOCK_SAMPLES, 128

blocks:
    .irp    o, 0, 1, 2, 3
    .irp    m, 0, 1, 2, 3
    .word   block_\o\()_\m - blocks
    .endr
    .rept   4
    .word   0                       | modes 4-7 unused
    .endr
    .endr

    .irp    o, 0, 1, 2, 3
block_\o\()_0:
    MODE0   \o
block_\o\()_1:
    MODE1   \o
block_\o\()_2:
    MODE2   \o
block_\o\()_3:
    MODE3   \o
    .endr

    | the program must end 256 bytes below SHARED, for the stack: the SH-2
    | side checks FMVSOUND_SIZE
