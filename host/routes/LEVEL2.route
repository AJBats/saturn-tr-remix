# Vilcabamba at 100% (Stella: 13 pickups with the silver key and gold idol,
# 3 secrets, 29 kills).
start LEVEL2 newgame
# the entrance doors open as the level starts
wait 90
# four wolves in the cave beyond the entrance
draw
fight 8192
# round the perimeter: along the narrow hallway (three bats, a wolf at the
# corner), the medipack in the greenery
goto 6 74240 44544
goto 6 66048 44544
fight
pickup 7
# on along the long passage to the pool (two bats drop)
goto 4 55808 26112
fight
# the stable: its bear woken from the passage outside (the trigger there),
# then shot from a spot it can't reach (in the open it's a near thing); the
# medipack in the hayloft
goto 15 73216 28160
safe 86 13 76288 26112
pickup 33
# under water: the lever by the trapdoor; up through it into secret 1
lever 31
pickup 29
expect secrets 1
# back in: the far lever opens a door by the second pool, secret 2 behind it
lever 30
wait 60
pickup 88
pickup 87
expect secrets 2

# the skull room: the switch by the carved stone door; up the stairs, a running
# jump, across the break-away tiles to the large medipack in the alcove
switch 16
wait 60
# a running jump to the ledge (as the planner finds it); then on across the
# break-away tiles before they fall, and a running jump over the pit to the
# alcove's platform, from the same spot each try
goto 23 59904 35328
attempt 17 59904 30208 60
goto 23 59904 35328 walk 24
face 180
keys UP 24
keys UP+A 30
wait 10
end
pickup 39
# down: the movable block pushed south into the next room (a bat), the silver
# key and the gold idol in the alcoves of the low platform
push 0 180 5
pickup 20
pickup 19
# up by the block onto the L-shaped platform (two bats), the large medipack by the window
pickup 4
# out of the window, down to the hallway; the silver key in the locked door by
# the pool; past its darts, five wolves round the red-roofed building
usehole 9
wait 60
goto 36 37376 28160
fight 8192

# the left door: up the pool room's ledges (a jump to a ledge four clicks up, a
# diagonal running jump across the pool), two bats, the medipack and the
# switch that opens the right door; the shells on the ledge outside, the
# medipack on the red roof
pickup 54
switch 53
pickup 52
pickup 48
# the right door: up the second pool room by its ledges over the break-away
# tiles (as the planner finds them), a bat, the switch that opens the middle door
switch 71
# the middle door: three swinging blades, each passed when it swings away;
# the switch past them drops the floor into a pool
goto 61 28160 29184
goto 61 27200 29184 walk 64
timed 61 25088 29184
timed 61 23040 29184
timed 61 20992 29184
switch 60
# swum through to the second pool, up the stairs: the switch that opens the
# exit's gate; the bear in the hall shot from where it can't reach (a balcony)
switch 84
safe 82 72 15872 31232
# the switch that stops the blades, the doorway opposite: down twice to secret 3
switch 83
pickup 89
expect secrets 3
# the gold idol in its hole by the gate, and out
usehole 79
endlevel 87 9728 29184
