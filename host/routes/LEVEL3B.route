# Tomb of Qualopec at 100% (Stella: 7 kills + the mummy, 8 pickups with the
# Scion, 3 secrets).
# tools/levelmap.py draws the level.
start LEVEL3B newgame
wait 30
# the switch left of the passage the boulder runs into opens the door the two
# raptors charge out of
switch 36
draw
fight 8192
# the face door (west from the crossroads): the block twice south, the one
# beside it once east, across the break-away tile to the first gate's switch,
# back over its spike pit with a standing jump
push 66 180 2
push 67 90 1
goto 37 49664 45568
face 180
keys UP 24
switch 65
# back over the pit: a standing jump from its edge (the corridor is four
# clicks high: the planner won't jump in it)
attempt 37 49664 45568
face 0
keys UP 12
keys UP+A 6
wait 40
end
goto 37 48640 47616
# the sun door (south): the alcove's break-away floor brought down, down into
# the three wolves' room; the block pulled once and pushed aside, up the
# stairs (the small medipack in the hole) to the third gate's switch and the
# small medipack in the corner
collapse 57
goto 33 58880 41472
fight
pull 62 180 1
push 62 90 1
pickup 61
switch 63
pickup 64
# the bird door (east): through the upper passage (door 75 opens on the way)
# to switch 76, which moves block 50 two sectors north; back to the room
# above the low ramp, switch 74 moves block 49 two sectors east
switch 76
switch 74
# from the raised alcove a running jump onto block 49, one onto block 50 (not
# in line with it), one over the spikes into the doorway: switch 53 opens the
# second gate. Back onto block 50 (a jump down off the doorway lands hard)
goto 27 69120 46592
leap 27 72192 47616
leap 28 74240 45568
switch 53
goto 28 74240 45568
leap 27 72192 47616
# through the three gates (the save crystal in the passage's turn walked
# round) and the dart room to the stairs
goto 22 55808 70144
goto 39 64000 71168
# secret 1: up into the alcove left of the statue over the first step (the
# door behind it opens), a run over the break-away tiles to the platform in
# the far corner: the shotgun (its shells, with one in hand)
goto 39 64624 74240
wait 30
goto 7 65024 75264
dash 7 64300 76500 64000 78336
pickup 29
# secret 2: hung from the platform's south edge, along it to the wall, let
# go between the spikes; the magnum clips under the platform; walked through
# the spikes (walked, they don't hurt) and up into the passage
traverse 7 64000 77980 0 left 63600 77720
wait 30
goto 4 64000 78336 spikes
pickup 19
goto 7 65024 75264 spikes
# down off the alcove onto the first step (hung first), up the stairs to the
# tomb: the mummy shot till it falls (it never moves; an extra kill), then
# the Scion
attempt 39 64700 73216
goto 39 64624 74240
face 0
keys DOWN+B 30
wait 40
end
goto 5 73216 60416
fight 8192
pickup 20
# the ceiling comes down and the boulder rolls down the ramp after her: out
# of its line in the big room, then round it where it stops in the passage's
# turn, to the stairs up to the lake
goto 20 56832 64512
wait 150
goto 19 49664 62208
creep 19 49250 62250 49070 62375 48900 62700 48640 63100
goto 19 46592 64000
# secret 3: down the lake's tunnel to the room off it (magnum clips, a large
# medipack)
pickup 27
pickup 28
# the large medipack up the cliff past Larson (left alone: he stays by the
# lake)
ignore on
pickup 31
ignore off
# Larson from the cave's mouth: his fall ends the level
goto 11 42496 48640
fight 8192
# (the film comes a little after his fall)
wait 600
