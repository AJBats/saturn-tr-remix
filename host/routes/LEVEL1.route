# The Caves at 100% (Stella's classic walkthrough, tombraiders.net/stella):
# 7 pickups, 3 secrets, 14 kills. Rooms and items as the level numbers them
# (host MAP=ROOM prints a room's sectors).
start LEVEL1 newgame

# the dart corridor, round the corner to the rectangular cave
goto 5 89600 36450
# secret 1: back to the angled block, backflip onto it, bounce off and grab
# the opening above, pull up
face 0
keys DOWN+A 12
keys A+B 45
keys UP+B 30
wait 60
expect room 36
pickup 58
expect secrets 1

# the bat cave, up the rocks of room 4, guns out at its mouth (one bat may
# fly off to come back later)
goto 2 78336 40448
face 0
draw
keys UP+L 40
fight
goto 2 78336 44544
fight
# secret 2: the cave on the left, the snowdrift under the opening, its high west end
goto 3 67840 49800
face 0
keys UP+B 60
wait 60
expect room 28
draw
fight
pickup 48
expect secrets 2

# down to the door with the switch
switch 10

# through the door (its bat), up to the bridges room, its wolves
wait 90
goto 15 22016 46592
fight

# the bear: woken at the edge of the gap, shot from above
goto 21 11264 63300
face 0
draw
fight
# the bear pit: its medipack
pickup 29

# the pad opens the timed door to the bridges room: on it facing the door, through
goto 17 15872 59904
face 90
wait 15
goto 16 20992 59904
goto 14 18944 55808
